{
  "name": "changran-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node server.mjs --production",
    "check:assets": "node scripts/verify-assets.mjs",
    "typecheck": "tsc --noEmit",
    "prestart": "node scripts/build-react.mjs",
    "check:deployment": "node scripts/verify-deployment.mjs",
    "postbuild": "node scripts/verify-deployment.mjs",
    "check:release": "npm run check && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "liquid-glass-react": "1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0"
  }
}
